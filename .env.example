# ===== PaddyGuard environment =====
# Copy to .env (never commit it). docker compose reads this file automatically; the server also reads it
# when run directly. Real environment variables always win over file values.

# ---- shared secret (REQUIRED) ----
# One long random string, e.g.  openssl rand -hex 32
# docker compose feeds it to BOTH services. When running them by hand, set INTERNAL_KEY for the ai-service
# and AI_INTERNAL_KEY (same value) for the server.
INTERNAL_KEY=
AI_INTERNAL_KEY=

# ---- image storage: Cloudinary (default) ----
STORAGE_DRIVER=cloudinary          # cloudinary | local (local = offline dev only)
# Option A: the single URL from the Cloudinary dashboard ("API Environment variable"):
#   CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Option B: three separate values (ignored if CLOUDINARY_URL is set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=paddyguard/scans
IMAGE_MAX_EDGE_PX=1600             # images are downscaled to fit this on upload

# ---- server (Express) ----
NODE_ENV=development               # production on Render
PORT=4000
MONGODB_URI=mongodb://localhost:27017/paddyguard   # Atlas: mongodb+srv://user:pass@cluster.mongodb.net/paddyguard
CLIENT_ORIGIN=http://localhost:5173                # React origin(s), comma-separated. REQUIRED in production.
TRUST_PROXY=false                                  # true behind a proxy such as Render (correct client IPs for rate limiting)
AI_SERVICE_URL=http://localhost:8000               # HF Space: https://<user>-<space>.hf.space
AI_TIMEOUT_MS=45000                                # per attempt, with one automatic retry; generous for cold starts
MAX_UPLOAD_MB=10
PUBLIC_BASE_URL=http://localhost:4000               # only used by STORAGE_DRIVER=local (URLs of saved images)
RATE_LIMIT_SCANS=30                                # scans per IP per window
RATE_LIMIT_WINDOW_MS=600000

# ---- ai-service (FastAPI) ----
MOCK_AI=false                                      # true = canned responses, no TensorFlow / model file needed
CONFIDENCE_THRESHOLD=0.85
UNCLEAR_MIN_MAX_PROB=0.40                          # TODO_VERIFY: tune with scripts/evaluate.py --ood-dir
UNCLEAR_MAX_NORM_ENTROPY=0.80                      # TODO_VERIFY
RESIZE_BACKEND=pil                                 # pil | tf  (A/B with scripts/evaluate.py --resize)
WEATHER_CACHE_TTL_S=3600
ENABLE_DOCS=false

# ---- client (Vite) ----
# Baked in at BUILD time (docker build arg / Vercel or Netlify environment variable).
VITE_API_BASE_URL=http://localhost:4000
