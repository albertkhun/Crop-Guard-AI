# --- ai-service ---
INTERNAL_KEY=change-me-long-random-string   # must match the Express server's AI_INTERNAL_KEY
MOCK_AI=false                               # true = canned responses, no TensorFlow needed
CONFIDENCE_THRESHOLD=0.85
UNCLEAR_MIN_MAX_PROB=0.40                   # TODO_VERIFY: tune with scripts/evaluate.py --ood-dir
UNCLEAR_MAX_NORM_ENTROPY=0.80               # TODO_VERIFY
RESIZE_BACKEND=pil                          # pil | tf  (A/B with scripts/evaluate.py --resize)
WEATHER_CACHE_TTL_S=3600
ENABLE_DOCS=false
