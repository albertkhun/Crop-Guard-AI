    "test:integration": "RUN_INTEGRATION=1 node --test --test-concurrency=1 test/integration.real-ai.test.js"
  },
  "dependencies": {
    "cloudinary": "2.11.0",
    "cors": "2.8.6",
    "dotenv": "18.0.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "mongoose": "9.11.1",
    "multer": "2.4.0"
  }
}
